# ---------------------------------------------------------------------------
# WeCrunch — environment variables. Copy to `.env` (never commit `.env`).
# This app must only ever connect to the WeCrunch database.
# ---------------------------------------------------------------------------

# PostgreSQL for WeCrunch ONLY. Use ONE of these two options.
#
# (a) Vercel Neon integration: Vercel adds these to the project (and `vercel env
#     pull` copies them locally). DATABASE_URL is pooled (the site);
#     DATABASE_URL_UNPOOLED is direct (migrations). Leave WECRUNCH_DATABASE_URL unset.
# DATABASE_URL=""
# DATABASE_URL_UNPOOLED=""
#
# (b) Any other PostgreSQL (local development, CI, Docker). Takes precedence over (a).
WECRUNCH_DATABASE_URL="postgresql://wecrunch_app:change-me@localhost:5434/wecrunch"
# Optional direct URL for `npm run db:deploy` when the URL above is pooled.
WECRUNCH_MIGRATE_DATABASE_URL=""
# Connections per server instance; use 5 on Vercel.
DB_POOL_MAX="10"

# Public origin of the site, used for canonical URLs, sitemap and Open Graph.
SITE_URL="http://localhost:3000"

# 32+ random bytes, base64. Used to hash visitor IPs for rate limiting and to
# sign internal tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=""

# Shared secret for /api/cron (scheduled publishing + data-retention purge).
# Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Initial super admin, used once by `npm run admin:create`. Remove afterwards.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Super Admin"

# ---- Media storage --------------------------------------------------------
# "local" (development only) or "blob" (Vercel Blob, when deployed on Vercel).
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./storage/uploads"
# Vercel Blob: connect a public Blob store to the Vercel project and it sets
# BLOB_READ_WRITE_TOKEN. To seed from your machine, copy it from the Vercel
# project (Settings → Environment Variables) into .env.
BLOB_READ_WRITE_TOKEN=""
BLOB_PREFIX="wecrunch/"   # keeps WeCrunch files apart if the store is ever shared
# CMS upload limit for videos, in MB. Use 4 on Vercel (4.5 MB request limit).
MAX_VIDEO_MB="100"

# ---- Email (optional; enquiries are saved even when email is not configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="WeCrunch <no-reply@wecrunchfranchise.com>"

# ---- Spam protection (optional Cloudflare Turnstile) ---------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---- Local embedded PostgreSQL (npm run db:start), development only -------
DEV_DB_PORT="5434"
