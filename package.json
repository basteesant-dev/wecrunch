{
  "name": "wecrunch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:start": "node scripts/db.mjs",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node node_modules/prisma/build/index.js migrate status",
    "db:seed": "node --import tsx prisma/seed.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "node scripts/e2e.mjs",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@vercel/blob": "^2.8.1",
    "dotenv": "^18.0.7",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
